@model ShipeX2.Application.DTOs.PrinterModel

@{
    ViewData["Title"] = "Edit Printer";
}

@section css {
    <style>
        .form-label {
            font-weight: bolder;
        }
    </style>
}

<div class="pagetitle">
    <h1>Edit Printer</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item"><a asp-action="PrinterList">Manage Printer</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body form-inner">
                    <form id="printerForm" data-parsley-validate>
                        <input type="hidden" id="PntId" name="PntId" value="@Model.PntId" />

                        <div class="row">
                            <div class="col-12">
                                <h4>Edit Printer</h4>
                                <hr />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="PntAliasName" class="form-label">Printer Name</label>
                                <input type="text" id="PntAliasName" name="PntAliasName" class="form-control"
                                       required value="@Model.PntAliasName"
                                       data-parsley-required-message="Printer Name is required." />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="PntMode" class="form-label">Printer Mode</label>
                                <select id="PntMode" name="PntMode" class="form-select"
                                        required data-parsley-required-message="Mode is required.">
                                    <option value="">Select Mode</option>
                                    <option value="Station" selected="@(Model.PntMode == "Station")">Station</option>
                                    <option value="Network" selected="@(Model.PntMode == "Network")">Network</option>
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="PntType" class="form-label">Printer Type</label>
                                <select id="PntType" name="PntType" class="form-select"
                                        required data-parsley-required-message="Type is required.">
                                    <option value="">Select Type</option>
                                    <option value="LABEL" selected="@(Model.PntType == "LABEL")">LABEL</option>
                                    <option value="PACK_INV" selected="@(Model.PntType == "PACK_INV")">PACK_INV</option>
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="PntIP" class="form-label">Printer IP</label>
                                <input type="text" id="PntIP" name="PntIP" class="form-control"
                                       required value="@Model.PntIP"
                                       data-parsley-required-message="IP Address is required." />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="PntIdentifier" class="form-label">Printer Identifier</label>
                                <input type="text" id="PntIdentifier" name="PntIdentifier" class="form-control"
                                       required value="@Model.PntIdentifier"
                                       data-parsley-required-message="Identifier is required." />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="CupsPrinterName" class="form-label">CUPS Printer Name</label>
                                <input type="text" id="CupsPrinterName" name="CupsPrinterName" class="form-control"
                                       required value="@Model.CupsPrinterName"
                                       data-parsley-required-message="CUPS Printer name is required." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 text-center mt-3">
                                <button type="submit" class="btn btn-primary custom-btn me-2">Update</button>
                                <a asp-action="PrinterList" class="btn btn-secondary">Back to List</a>
                            </div>
                        </div>
                    </form>

                    <div id="responseMessage" class="mt-3 text-center"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#printerForm').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);

                if (form.parsley().isValid()) {
                    let model = {
                        PntId: $('#PntId').val(),
                        PntAliasName: $('#PntAliasName').val(),
                        PntType: $('#PntType').val(),
                        PntMode: $('#PntMode').val(),
                        PntIP: $('#PntIP').val(),
                        PntIdentifier: $('#PntIdentifier').val(),
                        CupsPrinterName: $('#CupsPrinterName').val()
                    };

                    $.ajax({
                        url: '@Url.Action("EditPrinter", "Printer")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(model),
                        success: function (response) {
                            if (response.IsSuccessful) {
                                toastr.success(response.Message);
                                setTimeout(() => {
                                    window.location.href = '@Url.Action("PrinterList", "Printer")';
                                }, 1500);
                            } else {
                                toastr.error(response.Message);
                            }
                        },
                        error: function () {
                            toastr.error("Server error occurred!");
                        }
                    });
                }
            });
        });
    </script>
}
