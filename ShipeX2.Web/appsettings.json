{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {CorrelationId} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ShipLogs\\Log_.txt",
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {CorrelationId} {Message}{NewLine}{Exception}",
          "rollingInterval": "Day"
        },
        "restrictedToMinimumLevel": "Error"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServerDb": "Data Source=.;Initial Catalog=TMS;User ID=sa;Password=Sql@2023;TrustServerCertificate=True;Encrypt=False",
    "OracleDb": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.3.8)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=tb10g)));User Id={CLIENT_ID};Password={CLIENT_ID};",
    "PostgresDb": "Host=localhost;Port=5432;Database=shipex_db;Username=postgres;Password=Pgsql@2025"
  }
}
